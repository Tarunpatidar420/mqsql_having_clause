const mongoose=require("mongoose")
async function main(){
    try{
        console.time("api")
    await mongoose.connect("mongodb://localhost:27017/companyDB ")
    console.timeEnd("api")
    console.log("connection successss")
    const admin=mongoose.connection.db.admin()
    const dbs=await admin.listDatabases()
    dbs.databases.forEach(e => {
        console.log(e.name)
        
    });
    console.log("collections hai")
       const  collection= await mongoose.connection.db.listCollections().toArray()
       collection.forEach((e)=>{
        console.log(e.name)
       })

    }
    catch(err){
        console.log(err)
    }
}
main()
